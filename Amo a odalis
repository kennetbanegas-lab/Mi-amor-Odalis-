<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Mil mensajes para mi amor 💖</title>
  <style>
    :root{--bg:#0b1020;--card:#0f1724;--accent:linear-gradient(90deg,#ff6bcb,#ffc36b,#9bffb8);}
    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}
    body{background: radial-gradient(circle at 10% 10%, #0f1330 0%, var(--bg) 40%), #04050a; color:#fff; overflow:hidden}

    .stage{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:20px;box-sizing:border-box}

    .card{width:100%;max-width:900px;background:linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));border-radius:20px;padding:18px;border:1px solid rgba(255,255,255,0.03);box-shadow:0 10px 30px rgba(2,6,23,0.6);}

    header{display:flex;align-items:center;gap:12px}
    .title{font-size:20px;font-weight:700;letter-spacing:-0.02em}
    .subtitle{font-size:13px;color:rgba(255,255,255,0.7)}

    .view{height:520px;overflow:hidden;border-radius:14px;margin-top:12px;position:relative;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(0,0,0,0.05));border:1px solid rgba(255,255,255,0.02)}

    .ticker{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:18px;box-sizing:border-box}

    .line{font-size:20px;padding:10px 14px;margin:6px 0;border-radius:12px;min-width:80%;max-width:95%;text-align:center;background:linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));backdrop-filter: blur(4px);box-shadow: 0 4px 18px rgba(0,0,0,0.6);}

    .emoji{margin-right:8px}

    /* sparkle animation */
    .sparkle{position:absolute;pointer-events:none;mix-blend-mode:screen}
    @keyframes floaty{0%{transform:translateY(0) rotate(0)}50%{transform:translateY(-10px) rotate(10deg)}100%{transform:translateY(0) rotate(0)}}

    .floating {animation: floaty 4s ease-in-out infinite}

    /* smooth scroll using transform */
    .ticker-inner{display:flex;flex-direction:column;align-items:center;}

    /* controls */
    .controls{display:flex;gap:8px;margin-top:10px;align-items:center}
    .btn{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:8px 12px;border-radius:10px;color:#fff;cursor:pointer}
    .small{font-size:13px}

    footer{font-size:12px;color:rgba(255,255,255,0.6);margin-top:10px;text-align:center}

    @media (max-width:520px){.line{font-size:16px}}
  </style>
</head>
<body>
  <div class="stage">
    <div class="card">
      <header>
        <img src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='48' height='48'><defs><linearGradient id='g' x1='0' x2='1' y1='0' y2='1'><stop offset='0' stop-color='%23ff6bcb'/><stop offset='0.6' stop-color='%23ffc36b'/><stop offset='1' stop-color='%239bffb8'/></linearGradient></defs><rect rx='10' width='48' height='48' fill='url(%23g)'/></svg>" alt="logo" style="width:48px;height:48px;border-radius:10px;"/>
        <div>
          <div class="title">Mil Mensajes para Odalis</div>
          <div class="subtitle">Escanea el QR (cuando esté online) o abre este archivo en el navegador 📱💌</div>
        </div>
      </header>

      <div class="view" id="viewport">
        <div class="ticker" id="ticker">
          <div class="ticker-inner" id="ticker-inner"></div>
        </div>
        <!-- sparkles -->
        <svg class="sparkle floating" style="left:12%;top:6%;width:60px;height:60px;opacity:0.9" viewBox="0 0 24 24"><path fill="url(#g)" d="M12 2l1.9 4.9L19 8l-4.5 3.1L15 16l-3-2.1L9 16l.5-4.9L5 8l5.1-1.1L12 2z"/></svg>
        <svg class="sparkle floating" style="right:8%;bottom:12%;width:40px;height:40px;opacity:0.8" viewBox="0 0 24 24"><path fill="url(#g)" d="M12 2l1.9 4.9L19 8l-4.5 3.1L15 16l-3-2.1L9 16l.5-4.9L5 8l5.1-1.1L12 2z"/></svg>
      </div>

      <div class="controls">
        <button class="btn" id="pause">Pausar</button>
        <button class="btn" id="play">Reanudar</button>
        <div style="flex:1"></div>
        <div class="small">Velocidad: <input id="speed" type="range" min="10" max="120" value="40"/></div>
      </div>

      <footer>Este regalo está personalizado para Odalis 🌹</footer>
    </div>
  </div>

  <script>
    // Generador de mensajes (millar de combinaciones). Personaliza la variable `nombre`.
    const nombre = 'Odalis'; // personalizado
    const templates = [
      `Te quiero, ${nombre} ❤️`,
      `Cada día a tu lado es un regalo 🌸`,
      `Eres mi sonrisa favorita 😊`,
      `Gracias por ser tú ✨`,
      `Con vos todo es mejor 💫`,
      `Tu risa ilumina mi mundo 🌞`,
      `Amarte es mi hobby preferido 💕`,
      `Eres pura magia y flores 🌺`,
      `Mi corazón late por vos 💓`,
      `Contigo hasta la luna y de regreso 🌙`,
      `Eres mi inspiración diaria 📖`,
      `Tus abrazos son mi lugar seguro 🤗`,
      `Hoy, mañana y siempre, te elijo a ti 💍`,
      `Eres belleza en movimiento 🌷`,
      `No puedo dejar de pensar en vos 🌟`
    ];

    // Generar N mensajes distintos mezclando templates y emojis
    const N = 2000; // "miles" de mensajes: 2000 para mantener tamaño razonable
    const extras = ['🌹','🌸','✨','💖','💫','🌟','🌺','💐','💕','💞','❣️'];

    function rand(a){return Math.floor(Math.random()*a)}

    const messages = [];
    for(let i=0;i<N;i++){
      const base = templates[rand(templates.length)];
      const e1 = extras[rand(extras.length)];
      const e2 = extras[rand(extras.length)];
      const num = i+1;
      messages.push(`${num}. ${base} ${e1}${e2}`);
    }

    // Poner los mensajes en el DOM
    const inner = document.getElementById('ticker-inner');
    messages.forEach(msg=>{
      const div = document.createElement('div');
      div.className='line';
      div.innerHTML = `<span class='emoji'>💌</span> ${msg}`;
      inner.appendChild(div);
    });

    // Duplicar contenido para scroll infinito
    const clone = inner.cloneNode(true);
    clone.id = 'ticker-inner-2';
    document.getElementById('ticker').appendChild(clone);

    // Scroll animation using transform
    let speed = 40; // pixels per second
    let paused = false;
    const ticker = document.getElementById('ticker');
    const tInner = document.getElementById('ticker-inner');
    const height = tInner.offsetHeight;
    let y = 0;
    let last = performance.now();

    function frame(now){
      const dt = now - last;
      last = now;
      if(!paused){
        y += (speed * dt)/1000;
        if(y >= height) y -= height;
        ticker.style.transform = `translateY(${-y}px)`;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    // Controls
    document.getElementById('pause').addEventListener('click',()=>paused=true);
    document.getElementById('play').addEventListener('click',()=>paused=false);
    const speedInput = document.getElementById('speed');
    speedInput.addEventListener('input',()=>{speed = Number(speedInput.value)});

    // To improve mobile autostart
    window.addEventListener('touchstart',()=>{} ,{passive:true});

    // Small accessibility: allow editing the name by pressing "E"
    window.addEventListener('keydown', (e)=>{
      if(e.key.toLowerCase()==='e'){
        const nuevo = prompt('Escribe el nombre que quieres mostrar (ej: Mariana)', nombre);
        if(nuevo){
          // replace text nodes with new name and restart
          location.reload();
        }
      }
    });
  </script>
</body>
</html>


